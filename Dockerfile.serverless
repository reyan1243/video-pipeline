# RunPod Serverless image.
#
# Layer order matters. Weights are ~1.8 GB and go in *before* the source, so
# editing code rebuilds only the last, cheap layer.
#
# Local build (for testing — RunPod builds this itself from GitHub):
#   docker build --platform linux/amd64 -f Dockerfile.serverless -t vp-test .
#
# --platform is required on Apple Silicon: an arm64 image pushes fine and then
# fails to start on RunPod's x86 hosts with an exec-format error.

# The official PyTorch image, not python:slim + `pip install torch`.
#
# That pip route broke on 2026-08-13: torch 2.6.0+cu124 hard-pins
# `nvidia-cudnn-cu12==9.1.0.70`, and NVIDIA removed that exact build from both
# their index and PyTorch's — the available list now jumps 9.0.0.312 -> 9.1.1.17.
# Nothing can be pinned around a file that no longer exists, and any pip-resolved
# CUDA stack is one upstream yank away from the same failure.
#
# This image ships torch, CUDA and cuDNN already matched, so there is no
# resolution step to break, and ~2.5 GB less to download at build time.
#
# cu128, not cu124. torch 2.6.0+cu124 compiles kernels for sm_50..sm_90 only.
# Blackwell cards (sm_120: RTX 5090, RTX PRO 6000; sm_100: B200) are outside
# that list, and landing on one kills the worker at import with:
#
#     CUDA error: no kernel image is available for execution on the device
#
# That is an *architecture* mismatch, not a driver one — the endpoint's "CUDA
# 12.4 and newer" filter gates on host driver version and lets Blackwell hosts
# through happily. Only a cu128 build has the kernels. 2.8.0 is the smallest
# jump that gets them; sm_86 cubins cover sm_89, so 4090/L40S keep working.
#
# Trade-off, deliberate: cu128 needs a 570+ host driver, so the endpoint's CUDA
# filter must be raised to 12.8+ (see DEPLOY.md §3). That drops hosts stuck on
# 12.4-12.7 and adds every Blackwell host — a much larger pool on net.
FROM pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt

# torch and torchvision come from the base image. Installing them again from
# requirements.txt would pull the CPU-only wheels off PyPI and silently replace
# the CUDA build — the worker would then run on CPU and every job would time out.
# runpod is pinned deliberately: 1.7.11-1.10.0 funnel nearly every job onto a
# single worker while the rest idle, and 1.9.0-1.10.1 can log "Worker is
# unhealthy, exiting" and then keep serving jobs anyway.
RUN grep -viE '^(torch|torchvision)[=<>]' requirements.txt > /tmp/requirements.docker.txt \
    && pip install --no-cache-dir -r /tmp/requirements.docker.txt \
    && pip install --no-cache-dir "runpod>=1.11.0,<1.12" boto3

# Fail loudly here if the base image ever ships a CPU-only torch, or one whose
# compiled kernels do not cover the GPUs this endpoint can land on.
#
# get_arch_list() reads the arch list out of the binary and needs no GPU, so it
# runs on RunPod's CPU builder. The old guard checked only `torch.version.cuda`,
# which is why the Blackwell mismatch got past the build and surfaced as a
# runtime crash on a worker instead.
RUN python -c "\
import torch, torchvision; \
assert torch.version.cuda, 'torch has no CUDA support'; \
archs = torch.cuda.get_arch_list(); \
print('torch', torch.__version__, 'cuda', torch.version.cuda, 'tv', torchvision.__version__); \
print('arch list:', archs); \
missing = [a for a in ('sm_86', 'sm_90', 'sm_120') if a not in archs]; \
assert not missing, f'base image lacks kernels for {missing}; arch list is {archs}'"

# HF_HOME must be identical at build and run time, or the worker re-downloads
# 1.8 GB on every cold start — on the meter, since start time is billed.
ENV HF_HOME=/opt/hf
ENV HF_HUB_DISABLE_TELEMETRY=1
ENV TOKENIZERS_PARALLELISM=false

# Hardcoded, not an ARG: RunPod's hosted GitHub build cannot pass --build-arg,
# so a build-arg-driven model choice would silently take the default there and
# diverge from a local build. Change the literal to swap models.
RUN python -c "\
from huggingface_hub import snapshot_download; \
snapshot_download('IDEA-Research/grounding-dino-base'); \
snapshot_download('facebook/sam2.1-hiera-large'); \
print('weights cached')"

COPY . /app

# Fail the build here rather than on the first request. The import chain is the
# thing that historically broke (torch/torchvision ABI, transformers pulling in
# torchvision at module load), and a broken worker looks like a queue stall.
RUN python -c "\
import sys; sys.path.insert(0, '/app'); \
from transformers import Sam2VideoModel, Sam2Model, AutoProcessor; \
import tracker, segmenter, detector, exporter, mask_ops, video_source; \
print('import chain OK')"

CMD ["python", "-u", "/app/rp_handler.py"]
